   "ic": "🏫",
   "t": "Talking about school",
   "steps": [
    {
     "t": "n",
     "de": "Hallo! In welche Klasse gehst du?",
     "en": "Hi! Which class are you in?"
    },
    {
     "t": "y",
     "o": [
      {
       "de": "Ich gehe in die neunte Klasse.",
       "en": "I am in ninth grade.",
       "ok": 1
      },
      {
       "de": "Ich gehe in der neunten Klasse.",
       "en": "",
       "ok": 0,
       "f": "With gehen (movement) use accusative: in die neunte Klasse. (Ich bin in der neunten Klasse works with sein.)"
      }
     ]
    },
    {
     "t": "n",
     "de": "Und was ist dein Lieblingsfach?",
     "en": "And what is your favourite subject?"
    },
    {
     "t": "y",
     "o": [
      {
       "de": "Mein Lieblingsfach ist Geschichte.",
       "en": "My favourite subject is history.",
       "ok": 1
      },
      {
       "de": "Mein Lieblingsfach bin Geschichte.",
       "en": "",
       "ok": 0,
       "f": "The subject of the sentence is a thing → ist."
      }
     ]
    },
    {
     "t": "n",
     "de": "Warum magst du Geschichte?",
     "en": "Why do you like history?"
    },
    {
     "t": "y",
     "o": [
      {
       "de": "Weil ich die Vergangenheit interessant finde.",
       "en": "Because I find the past interesting.",
       "ok": 1
      },
      {
       "de": "Weil ich finde die Vergangenheit interessant.",
       "en": "",
       "ok": 0,
       "f": "After weil the verb goes to the END."
      }
     ]
    },
    {
     "t": "n",
     "de": "Hast du heute viele Hausaufgaben?",
     "en": "Do you have a lot of homework today?"
    },
    {
     "t": "y",
     "o": [
      {
       "de": "Nein, ich habe nur wenige Hausaufgaben.",
       "en": "No, I only have a few homework assignments.",
       "ok": 1
      },
      {
       "de": "Nein, ich haben nur wenige Hausaufgaben.",
       "en": "",
       "ok": 0,
       "f": "ich → habe."
      }
     ]
    }
   ]
