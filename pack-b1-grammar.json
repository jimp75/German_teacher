    [
     "ex",
     [
      [
       "Ich hätte gern einen Kaffee.",
       "I would like a coffee."
      ],
      [
       "Könnten Sie mir helfen?",
       "Could you help me?"
      ],
      [
       "Wenn ich Zeit hätte, würde ich reisen.",
       "If I had time, I would travel."
      ],
      [
       "An deiner Stelle würde ich früher gehen.",
       "In your place I would leave earlier."
      ]
     ]
    ],
    [
     "tip",
     "For most verbs use würde + infinitive (ich würde gehen). Use the short forms for sein, haben and modal verbs."
    ]
