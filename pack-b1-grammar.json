      "dass",
      "das",
      "weil",
      "wenn"
     ],
     "a": 0,
     "e": "dass = that (conjunction); das = the / that (pronoun)."
    },
    {
     "t": "order",
     "q": "Because I am tired, I go to bed.",
     "a": "Weil ich müde bin, gehe ich ins Bett.",
     "e": "Subordinate clause first → verb comes next in the main clause."
    },
    {
     "t": "mc",
     "q": "Obwohl es regnet, ___.",
     "o": [
      "gehen wir spazieren",
      "wir gehen spazieren",
      "wir spazieren gehen",
      "spazieren wir gehen"
     ],
     "a": 0,
     "e": "Subordinate clause first → verb first in the main clause."
    },
    {
     "t": "fill",
     "q": "Ich frage, ___ er Zeit hat. (whether)",
     "a": [
      "ob"
     ],
     "e": ""
    },
    {
     "t": "mc",
     "q": "Als ich ein Kind ___, wohnte ich in Lyon.",
     "o": [
      "war",
      "bin",
      "sein",
      "wäre"
     ],
     "a": 0,
     "e": "als + single past event → war."
    },
    {
     "t": "mc",
     "q": "“Whenever I am tired, I drink coffee.”",
     "o": [
      "Wenn ich müde bin, trinke ich Kaffee.",
      "Als ich müde bin, trinke ich Kaffee.",
      "Wenn ich bin müde, trinke ich Kaffee.",
      "Als ich bin müde, trinke ich Kaffee."
     ],
     "a": 0,
     "e": "Repeated / present → wenn; verb at the end."
    },
    {
     "t": "order",
     "q": "I know that you are right.",
     "a": "Ich weiß, dass du recht hast.",
     "e": ""
    }
