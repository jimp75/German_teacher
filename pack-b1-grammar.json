 "units": [
  {
   "id": "b1",
   "lv": "B1",
   "ic": "🔗",
   "t": "Subordinate clauses",
   "s": "weil, dass, wenn, obwohl, als, ob",
   "notes": [
    [
     "h",
     "Verb to the END"
    ],
    [
     "ex",
     [
      [
       "Ich bleibe zu Hause, weil ich krank bin.",
       "I stay at home because I am ill."
      ],
      [
       "Ich weiß, dass du recht hast.",
       "I know that you are right."
      ],
      [
       "Ich frage, ob er Zeit hat.",
       "I ask whether he has time."
      ],
      [
       "Obwohl es regnet, gehen wir spazieren.",
       "Although it rains, we go for a walk."
      ]
     ]
    ],
    [
     "tip",
     "If the subordinate clause comes FIRST, the main clause starts with its verb: Weil ich müde bin, gehe ich ins Bett."
    ],
    [
     "tip",
     "wenn = whenever / if (present, repeated). als = when (one event in the past)."
    ]
   ],
   "v": [
    [
     "weil",
     "because"
    ],
    [
     "dass",
     "that"
    ],
    [
     "wenn",
     "if / whenever"
    ],
    [
     "obwohl",
     "although"
    ],
    [
     "als",
     "when (past, once)"
    ],
    [
     "ob",
     "whether"
    ],
    [
     "damit",
     "so that"
    ],
    [
     "bevor",
     "before"
    ],
    [
     "nachdem",
     "after"
    ],
    [
     "während",
     "while"
    ]
   ],
   "x": [
    {
     "t": "fill",
     "q": "Ich bleibe zu Hause, weil ich krank ___. (sein)",
     "a": [
      "bin"
     ],
     "e": "Verb at the end after weil."
    },
    {
     "t": "mc",
     "q": "Ich weiß, ___ er morgen kommt.",
