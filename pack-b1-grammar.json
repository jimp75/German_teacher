  {
   "id": "b3",
   "lv": "B1",
   "ic": "🧵",
   "t": "Relative clauses",
   "s": "der Mann, der …",
   "notes": [
    [
     "h",
     "Relative pronoun"
    ],
    [
     "p",
     "Gender and number come from the noun it refers to. The <b>case</b> comes from its role inside the relative clause. The verb goes to the end."
    ],
    [
     "tbl",
     [
      "",
      "m",
      "f",
      "n",
      "pl"
     ],
     [
      [
       "Nominative",
       "der",
       "die",
       "das",
       "die"
      ],
      [
       "Accusative",
       "den",
       "die",
       "das",
       "die"
      ],
      [
       "Dative",
       "dem",
       "der",
       "dem",
       "denen"
      ]
     ]
    ],
    [
     "ex",
     [
      [
       "Das ist der Mann, der neben mir wohnt.",
       "That is the man who lives next to me."
      ],
      [
       "Das ist die Frau, die ich kenne.",
       "That is the woman whom I know."
      ],
      [
       "Das ist das Buch, das ich lese.",
       "That is the book that I am reading."
      ],
      [
       "Das sind die Kinder, denen ich helfe.",
       "Those are the children I help."
      ]
     ]
    ]
   ],
   "v": [
    [
     "der Relativsatz",
     "relative clause"
    ],
    [
     "der Nachbar",
     "neighbour"
    ],
    [
     "die Nachbarin",
     "neighbour (f)"
    ],
    [
     "das Gebäude",
     "building"
    ],
    [
